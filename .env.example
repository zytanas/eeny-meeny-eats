# Copy this file to .env and fill in real values. Never commit .env.
#
# IMPORTANT: Only variables prefixed with VITE_ are bundled into the browser
# build by Vite. Everything else is available only to Netlify Functions
# (server-side) via process.env.

# --- Server-side only (Netlify Functions) ---------------------------------

# Geoapify Places API: finds nearby restaurants and cafes
GEOAPIFY_API_KEY=

# Google Places API (New): used only for rating + userRatingCount
GOOGLE_PLACES_API_KEY=

# Supabase project URL, used by functions
SUPABASE_URL=

# Supabase service role key. It BYPASSES Row Level Security.
# Keep it server-side only. Never prefix it with VITE_ or use it in src/.
SUPABASE_SERVICE_ROLE_KEY=

# --- Exposed to the browser (safe to be public) ---------------------------

# Supabase project URL for the frontend client
VITE_SUPABASE_URL=

# Supabase anon (public) key. Access is restricted by RLS policies.
VITE_SUPABASE_ANON_KEY=
