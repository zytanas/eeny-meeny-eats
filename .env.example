# Copy this file to .env and fill in real values. Never commit .env.
#
# All three are read only by the Netlify Functions (server-side, via process.env).
# None has a VITE_ prefix, so Vite never bundles them into the browser build; keep it that way.
# On Netlify, add them under Site configuration > Environment variables, scoped to Functions.

# Geoapify API key: nearby places, typed-area search and naming GPS spots. Mark as secret.
GEOAPIFY_API_KEY=your-geoapify-api-key

# Supabase project URL (Project Settings > API), used for the places cache and reports
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role (secret) key. It BYPASSES Row Level Security: keep it server-side,
# never prefix it with VITE_ or use it in src/. Mark as secret.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
